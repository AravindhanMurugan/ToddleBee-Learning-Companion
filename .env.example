# Local development defaults. Never commit real credentials.
NODE_ENV=development
PORT=5000
BASE_PATH=/
DATABASE_URL=postgresql://user:password@host:5432/toddlebee

# Optional when running outside Replit. On Replit, use the connected integration.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TAMIL_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Reserved examples only. AgenticOrg and Pine Labs are not wired in this demo.
AGENTICORG_API_KEY=
AGENTICORG_AGENT_ID=
PINE_LABS_API_KEY=
PINE_LABS_MERCHANT_ID=
PINE_LABS_ENVIRONMENT=sandbox
